# --- Phase 2: AI brain -------------------------------------------------------
# NEXUS talks to a local Ollama model or to Gemini. Left unset it AUTO-DETECTS,
# and it prefers LOCAL: if Ollama is running, it uses it. Force one with
# NEXUS_AI_PROVIDER=ollama or NEXUS_AI_PROVIDER=gemini.
NEXUS_AI_PROVIDER=

# Ollama needs no key at all. Install it, then:
#   ollama pull llama3.2 && ollama serve
# Any tool-calling model works: llama3.2, qwen2.5, mistral-nemo.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Gemini. Server-side only; never exposed to the client. This must be an AI
# STUDIO key (starts with "AIzaSy") from https://aistudio.google.com/apikey —
# an OAuth token or a service account JSON will not work, and the app now says
# so explicitly instead of returning a bare 400.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Phase 3: knowledge engine ----------------------------------------------
# Every one of these is optional. A module with no key falls back to its
# deterministic sample adapter and reports provenance as "sample".
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FINNHUB_API_KEY=
OPENWEATHER_API_KEY=
NEWS_API_KEY=
FOOTBALL_DATA_API_KEY=

# --- Phase 5: desktop bridge -------------------------------------------------
# The bridge is OFF unless this is exactly "1". macOS only.
NEXUS_BRIDGE_ENABLED=0
